# Local environment for Enterprise Dependency Intelligence.
# Copy to `.env` and edit. `.env` is gitignored — never commit secrets.
#
#   copy .env.example .env

# --- Graph store (ADR-0001) ---
GRAPH_STORE_BACKEND=neo4j
NEO4J_URI=bolt://192.168.4.52:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=edi-local-dev
# GRAPH_FALLBACK_SQLITE_PATH=data/graph_fallback.sqlite3

# --- MVP2 Graph RAG (ADR-0005) ---
# Set true and fill OPENAI_API_KEY to enable open-ended Ask.
GRAPH_RAG_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- MVP3 Hybrid Doc RAG (ADR-0006) ---
# Requires GRAPH_RAG_ENABLED=true + OPENAI_API_KEY. Index docs first:
#   python -m src.retrieval.index_docs
HYBRID_DOC_RAG_ENABLED=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# VECTOR_STORE_PATH=data/vectors/chunks.sqlite3
# HYBRID_DOC_TOP_K=5

# --- MVP4 Agentic Investigation (ADR-0007) ---
# Separate /investigate flow (Ask unchanged). Requires OPENAI_API_KEY.
AGENTIC_INVESTIGATION_ENABLED=false
# AGENTIC_MAX_TOOL_CALLS=3

# --- MVP5 Advanced Intelligence (ADR-0008) ---
# Deterministic risk / what-if / drift / rationalize are always on.
# Optional LLM narrative over computed factors (never invents scores):
INTELLIGENCE_NARRATIVE_ENABLED=false

# --- Observability ---
NLQUERY_LOG_PATH=data/nlquery.log
